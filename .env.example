# Copy this file to ".env" (same folder) and fill in the values below.
# .env is gitignored, so your credentials are never committed.

# --- Data source -----------------------------------------------------------
# Which data source the backend reads from:
#   csv  (default) -> reads data/grid_assignments.csv on local disk
#   github         -> reads/commits data/grid_assignments.csv in the GitHub repo (used on Vercel)
#   db             -> reads the live Postgres database (analysis.* views)
DATA_BACKEND=csv

# csv backend only: override the CSV path (handy to point tests at a copy so
# they never mutate the real data file). Defaults to data/grid_assignments.csv.
# GRID_CSV_PATH=/tmp/grid_test.csv

# github backend only. Every save becomes a commit to the CSV in the repo.
# Fine-grained personal access token with "Contents: Read and write" on this
# repo only (GitHub -> Settings -> Developer settings -> Fine-grained tokens):
# GITHUB_TOKEN=github_pat_xxx
# "owner/name". On Vercel it defaults to the repo the project deploys from:
# GITHUB_REPO=uhm-campus-energy/grid-assignments
# Optional; defaults shown:
# GITHUB_BRANCH=main
# GITHUB_CSV_PATH=data/grid_assignments.csv

# db backend only: Postgres connection string (behind the VPN).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# --- Login ------------------------------------------------------------------
# Local dev / tests: skip Google and act as this admin. Ignored on Vercel.
# Personal assignments also need POSTGRES_URL (below); without it they are off.
# Leave unset to test the real sign-in locally.
DEV_LOGIN_EMAIL=you@hawaii.edu

# Real sign-in (required on Vercel). See DEPLOY.md, "Login".
# OAuth client ID (Google Cloud Console -> Credentials, type "Web application"):
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# Long random string that signs the session cookie. Changing it signs everyone out.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# AUTH_SECRET=
# Comma-separated emails that are always admins (can save). Everyone else is a
# viewer until promoted in the users table.
# ADMIN_EMAILS=you@hawaii.edu,mentor@hawaii.edu
# The Neon Postgres holding the users table. Vercel sets this itself when you
# connect the database; locally, copy it from `vercel env pull`.
# POSTGRES_URL=postgresql://...

# --- CORS (optional) -------------------------------------------------------
# Extra allowed origins (comma-separated). Not needed on Vercel (same-origin).
# CORS_ORIGINS=https://your-app.vercel.app
